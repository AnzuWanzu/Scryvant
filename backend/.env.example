NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/scryvant
APP_ORIGIN=http://localhost:5174
# Generate a unique value with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
EMAIL_FROM=Scryvant <hello@scryvant.local>
# Both values are required to enable Gemini; manual play works without them.
GEMINI_API_KEY=
GEMINI_MODEL=
AI_DAILY_LIMIT=20
