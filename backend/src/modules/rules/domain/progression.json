  "feats": [
    {
      "id": "alert",
      "name": "Alert",
      "category": "Origin",
      "text": "You gain the following benefits.\nInitiative Proficiency. When you roll Initiative,\nyou can add your Proficiency Bonus to the roll.\nInitiative Swap. Immediately after you roll Initia-\ntive, you can swap your Initiative with the Initiative\nof one willing ally in the same combat. You can’t\nmake this swap if you or the ally has the Incapaci-\ntated condition.",
      "page": 87
    },
    {
      "id": "magic-initiate",
      "name": "Magic Initiate",
      "category": "Origin",
      "text": "You gain the following benefits.\nTwo Cantrips. You learn two cantrips of your\nchoice from the Cleric, Druid, or Wizard spell list.\nIntelligence, Wisdom, or Charisma is your spellcast-\ning ability for this feat’s spells (choose when you\nselect this feat).\nLevel 1 Spell. Choose a level 1 spell from the same\nlist you selected for this feat’s cantrips. You always\nhave that spell prepared. You can cast it once with-\nout a spell slot, and you regain the ability to cast it\nin that way when you finish a Long Rest. You can\nalso cast the spell using any spell slots you have.\nSpell Change. Whenever you gain a new level, you\ncan replace one of the spells you chose for this feat\nwith a different spell of the same level from the cho-\nsen spell list.\nRepeatable. You can take this feat more than\nonce, but you must choose a different spell list each\ntime.",
      "page": 87
    },
    {
      "id": "savage-attacker",
      "name": "Savage Attacker",
      "category": "Origin",
      "text": "You’ve trained to deal particularly damaging\nstrikes. Once per turn when you hit a target with\na weapon, you can roll the weapon’s damage dice\ntwice and use either roll against the target.",
      "page": 87
    },
    {
      "id": "skilled",
      "name": "Skilled",
      "category": "Origin",
      "text": "You gain proficiency in any combination of three\nskills or tools of your choice.\nRepeatable. You can take this feat more than\nonce.\nGeneral Feats",
      "page": 87
    },
    {
      "id": "ability-score-improvement",
      "name": "Ability Score Improvement",
      "category": "General",
      "text": "Increase one ability score of your choice by 2, or\nincrease two ability scores of your choice by 1. This\nfeat can’t increase an ability score above 20.\nRepeatable. You can take this feat more than\nonce.",
      "page": 87
    },
    {
      "id": "grappler",
      "name": "Grappler",
      "category": "General",
      "text": "Dexterity 13+)\nYou gain the following benefits.\nAbility Score Increase. Increase your Strength or\nDexterity score by 1, to a maximum of 20.\nPunch and Grab. When you hit a creature with an\nUnarmed Strike as part of the Attack action on your\nturn, you can use both the Damage and the Grapple\noption. You can use this benefit only once per turn.\nAttack Advantage. You have Advantage on attack\nrolls against a creature Grappled by you.\nFast Wrestler. You don’t have to spend extra\nmovement to move a creature Grappled by you if the\ncreature is your size or smaller.\nFighting Style Feats",
      "page": 87
    },
    {
      "id": "archery",
      "name": "Archery",
      "category": "Fighting Style",
      "text": "Feature)\nYou gain a +2 bonus to attack rolls you make with\nRanged weapons.\nSystem Reference Document 5.2.1 88",
      "page": 87
    },
    {
      "id": "defense",
      "name": "Defense",
      "category": "Fighting Style",
      "text": "Feature)\nWhile you’re wearing Light, Medium, or Heavy ar-\nmor, you gain a +1 bonus to Armor Class.",
      "page": 88
    },
    {
      "id": "great-weapon-fighting",
      "name": "Great Weapon Fighting",
      "category": "Fighting Style",
      "text": "Feature)\nWhen you roll damage for an attack you make with\na Melee weapon that you are holding with two\nhands, you can treat any 1 or 2 on a damage die as a\n3. The weapon must have the Two-Handed or Versa-\ntile property to gain this benefit.",
      "page": 88
    },
    {
      "id": "two-weapon-fighting",
      "name": "Two-Weapon Fighting",
      "category": "Fighting Style",
      "text": "Feature)\nWhen you make an extra attack as a result of using\na weapon that has the Light property, you can add\nyour ability modifier to the damage of that attack if\nyou aren’t already adding it to the damage.\nEpic Boon Feats",
      "page": 88
    },
    {
      "id": "boon-of-combat-prowess",
      "name": "Boon of Combat Prowess",
      "category": "Epic Boon",
      "text": "You gain the following benefits.\nAbility Score Increase. Increase one ability score\nof your choice by 1, to a maximum of 30.\nPeerless Aim. When you miss with an attack roll,\nyou can hit instead. Once you use this benefit, you\ncan’t use it again until the start of your next turn.",
      "page": 88
    },
    {
      "id": "boon-of-dimensional-travel",
      "name": "Boon of Dimensional Travel",
      "category": "Epic Boon",
      "text": "You gain the following benefits.\nAbility Score Increase. Increase one ability score\nof your choice by 1, to a maximum of 30.\nBlink Steps. Immediately after you take the At-\ntack action or the Magic action, you can teleport up\nto 30 feet to an unoccupied space you can see.",
      "page": 88
    },
    {
      "id": "boon-of-fate",
      "name": "Boon of Fate",
      "category": "Epic Boon",
      "text": "You gain the following benefits.\nAbility Score Increase. Increase one ability score\nof your choice by 1, to a maximum of 30.\nImprove Fate. When you or another creature\nwithin 60 feet of you succeeds on or fails a D20\nTest, you can roll 2d4 and apply the total rolled as a\nbonus or penalty to the d20 roll. Once you use this\nbenefit, you can’t use it again until you roll Initiative\nor finish a Short or Long Rest.",
      "page": 88
    },
    {
      "id": "boon-of-irresistible-offense",
      "name": "Boon of Irresistible Offense",
      "category": "Epic Boon",
      "text": "You gain the following benefits.\nAbility Score Increase. Increase your Strength or\nDexterity score by 1, to a maximum of 30.\nOvercome Defenses. The Bludgeoning, Pierc-\ning, and Slashing damage you deal always ignores\nResistance.\nOverwhelming Strike. When you roll a 20 on the\nd20 for an attack roll, you can deal extra damage\nto the target equal to the ability score increased by\nthis feat. The extra damage’s type is the same as the\nattack’s type.",
      "page": 88
    },
    {
      "id": "boon-of-spell-recall",
      "name": "Boon of Spell Recall",
      "category": "Epic Boon",
      "text": "Feature)\nYou gain the following benefits.\nAbility Score Increase. Increase your Intelligence,\nWisdom, or Charisma score by 1, to a maximum of\n30.\nFree Casting. Whenever you cast a spell with a\nlevel 1–4 spell slot, roll 1d4. If the number you roll is\nthe same as the slot’s level, the slot isn’t expended.",
      "page": 88
    },
    {
      "id": "boon-of-the-night-spirit",
      "name": "Boon of the Night Spirit",
      "category": "Epic Boon",
      "text": "You gain the following benefits.\nAbility Score Increase. Increase one ability score\nof your choice by 1, to a maximum of 30.\nMerge with Shadows. While within Dim Light or\nDarkness, you can give yourself the Invisible condi-\ntion as a Bonus Action. The condition ends on you\nimmediately after you take an action, a Bonus Ac-\ntion, or a Reaction.\nShadowy Form. While within Dim Light or Dark-\nness, you have Resistance to all damage except Psy-\nchic and Radiant.",
      "page": 88
    },
    {
      "id": "boon-of-truesight",
      "name": "Boon of Truesight",
      "category": "Epic Boon",
      "text": "You gain the following benefits.\nAbility Score Increase. Increase one ability score\nof your choice by 1, to a maximum of 30.\nTruesight. You have Truesight with a range of 60\nfeet.",
      "page": 88
    }
  ]
}
